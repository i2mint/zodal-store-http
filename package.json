{
  "name": "@zodal/store-http",
  "version": "0.1.1",
  "description": "zodal DataProvider adapter for a REST/HTTP backend (fetch-based, browser-first)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@zodal/core": "^0.2.2",
    "@zodal/store": "^0.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@zodal/core": "^0.2.2",
    "@zodal/store": "^0.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i2mint/zodal-store-http.git"
  },
  "keywords": [
    "zodal",
    "dataprovider",
    "http",
    "rest",
    "fetch",
    "api",
    "storage",
    "adapter"
  ],
  "packageManager": "pnpm@9.15.0"
}
